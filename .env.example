# Copy to .env.local and adjust.
# Matches the database in docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgres://kingsol:kingsol@localhost:54329/kingsol

# Set to "true" only if your Postgres requires TLS (most hosted providers do).
DATABASE_SSL=false

# Session cookies are Secure (HTTPS-only) in production. Set to "false" only when serving
# the production build over plain HTTP, e.g. on a local network.
SESSION_COOKIE_SECURE=true
